# Copia este ficheiro para ".env" e preenche os valores reais.
# O ".env" está no .gitignore e nunca deve ser enviado para o git.
# As chaves do Discord e dos servidores AeroHub só são usadas na Fase 2.

# Discord Rich Presence
DISCORD_CLIENT_ID=

# Servidores AeroHub
AEROHUB_API_URL=

# Ecrã com que o app arranca em desenvolvimento (não é segredo):
#   installer → instalador (padrão)
#   splash    → como app já instalado e com sessão: animação do ícone e depois o Início
#   welcome   → Boas-vindas (login)
VITE_START_SCREEN=

# Contas AeroHub Radar (projeto Supabase novo). A chave "anon" é pública (vai no app); nunca a service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Site onde a pessoa aprova a ligação do app (no PC: http://localhost:5181)
VITE_RADAR_SITE_URL=https://aerohubradar.com
# Nome (endereço) da função do Supabase que entrega a sessão ao app
VITE_CONNECTOR_LINK_FUNCTION=smart-handler

# Feeder: servidor do AeroHub Group (sem isto: o domínio verdadeiro). Em testes no PC: ws://localhost:8080/api/feeder/ws
VITE_FEEDER_SERVER_URL=
